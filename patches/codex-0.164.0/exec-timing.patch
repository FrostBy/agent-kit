     #[test]
+    fn command_header_elapsed_and_live_lines_snapshot() {
+        let mut cell = new_active_exec_command(
+            "call-id".into(),
+            vec!["echo".into(), "output".into()],
+            Vec::new(),
+            ExecCommandSource::Agent,
+            None,
+            false,
+        );
+        cell.group.calls[0].start_time = None;
+        let render = |cell: &ExecCell, width| render_line_text(&cell.display_lines(width)[0]);
+        let fast = render(&cell, 80);
+        assert!(cell.append_output("call-id", "first\nsecond\npartial"));
+        cell.group.calls[0].start_time = Some(Instant::now() - std::time::Duration::from_secs(10));
+        let running = render(&cell, 80);
+        let header = &cell.display_lines(80)[0];
+        assert!(
+            header
+                .spans
+                .iter()
+                .filter(|span| span.content.contains('·'))
+                .all(|span| span.style.add_modifier.contains(Modifier::DIM))
+        );
+        assert!(cell.display_lines(24).iter().all(|line| line.width() <= 24));
+        assert!(cell.complete_call(
+            "call-id",
+            CommandOutput::new(0, "first\nsecond\npartial".into()),
+            std::time::Duration::from_secs(11),
+        ));
+        let ran = render(&cell, 80);
+        cell.group.calls[0].source = ExecCommandSource::UserShell;
+        let user_shell = render(&cell, 80);
+        cell.group.calls[0].duration = Some(std::time::Duration::from_millis(999));
+        let fast_ran = render(&cell, 80);
+        insta::assert_snapshot!(
+            "command_header_elapsed_and_live_lines",
+            format!(
+                "fast: {fast}\nrunning: {running}\nran: {ran}\nuser shell: {user_shell}\nfast ran: {fast_ran}"
+            )
+        );
+    }
+
+    #[test]
+    fn live_line_header_counts_completed_lines_even_after_truncation() {
+        let mut cell = new_active_exec_command(
+            "call-id".into(),
+            vec!["echo".into(), "output".into()],
+            Vec::new(),
+            ExecCommandSource::Agent,
+            None,
+            false,
+        );
+        cell.group.calls[0].start_time = None;
+        assert!(cell.append_output("call-id", "partial"));
+        assert_eq!(
+            render_line_text(&cell.display_lines(80)[0]),
+            "• Running echo output"
+        );
+        assert!(cell.append_output("call-id", "\n"));
+        assert_eq!(
+            render_line_text(&cell.display_lines(80)[0]),
+            "• Running echo output · 1 line"
+        );
+        assert!(cell.append_output("call-id", &format!("{}partial", "x\n".repeat(600_000))));
+        assert_eq!(
+            render_line_text(&cell.display_lines(80)[0]),
+            "• Running echo output · 600001 lines"
+        );
+        assert!(cell.group.calls[0].output.as_ref().unwrap().line_counts().1 < 600_001);
+    }
