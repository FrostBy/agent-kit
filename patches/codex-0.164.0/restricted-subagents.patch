+#[tokio::test]
+async fn spawn_restricted_modes_apply_before_initial_input() {
+    use crate::agent::types::RestrictedAgentMode;
+    for mode in [RestrictedAgentMode::Plan, RestrictedAgentMode::ReadOnly] {
+        let harness = AgentControlHarness::new().await;
+        let (parent_id, _) = harness.start_thread().await;
+        let child_id = harness
+            .spawn_anonymous_child(
+                parent_id,
+                SpawnAgentOptions {
+                    mode: Some(mode),
+                    ..Default::default()
+                },
+            )
+            .await;
+        let child = harness.manager.get_thread(child_id).await.unwrap();
+        let snapshot = child.config_snapshot().await;
+        if mode == RestrictedAgentMode::Plan {
+            assert_eq!(snapshot.collaboration_mode.mode, ModeKind::Plan);
+        } else {
+            assert_eq!(snapshot.approval_policy, AskForApproval::Never);
+            let fs = snapshot.permission_profile.file_system_sandbox_policy();
+            assert!(!fs.has_full_disk_write_access());
+            assert!(
+                fs.get_writable_roots_with_cwd(harness.config.cwd.as_path())
+                    .is_empty()
+            );
+            let environments = child.session.inherited_environment_snapshot().await;
+            for environment in environments.turn_environments() {
+                let fs = environment
+                    .permission_profile()
+                    .file_system_sandbox_policy();
+                assert!(!fs.has_full_disk_write_access());
+                assert!(
+                    fs.get_writable_roots_with_cwd(harness.config.cwd.as_path())
+                        .is_empty()
+                );
+            }
+        }
+    }
+}
