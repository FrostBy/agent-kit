+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RestrictedAgentMode {
+    Plan,
+    ReadOnly,
+}
+
+impl RestrictedAgentMode {
+    pub(crate) fn from_task_name(task_name: &str) -> (Option<Self>, &str) {
+        if let Some(name) = task_name.strip_prefix("readonly-") {
+            (Some(Self::ReadOnly), name)
+        } else if let Some(name) = task_name.strip_prefix("plan-") {
+            (Some(Self::Plan), name)
+        } else {
+            (None, task_name)
+        }
+    }
+}
+
+#[cfg(test)]
+mod restriction_tests {
+    use super::RestrictedAgentMode;
+    use codex_protocol::AgentPath;
+
+    #[test]
+    fn task_name_prefix_only_restricts_and_preserves_native_validation() {
+        for (input, mode, name) in [
+            (
+                "readonly-review_1",
+                Some(RestrictedAgentMode::ReadOnly),
+                "review_1",
+            ),
+            ("plan-design", Some(RestrictedAgentMode::Plan), "design"),
+            ("review_1", None, "review_1"),
+            ("readonly_review", None, "readonly_review"),
+            ("plan", None, "plan"),
+        ] {
+            assert_eq!(RestrictedAgentMode::from_task_name(input), (mode, name));
+            assert!(AgentPath::root().join(name).is_ok());
+        }
+        for input in [
+            "readonly-",
+            "plan-",
+            "readonly-root",
+            "plan-../escape",
+            "plan-Upper",
+            "readonly-plan-review",
+        ] {
+            let (_, name) = RestrictedAgentMode::from_task_name(input);
+            assert!(AgentPath::root().join(name).is_err(), "{input}");
+        }
+    }
+}
