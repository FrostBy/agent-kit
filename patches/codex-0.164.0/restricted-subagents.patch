+    #[test]
+    fn spawn_mode_accepts_only_restrictions() {
+        for (mode, expected) in [
+            ("plan", RestrictedAgentMode::Plan),
+            ("read_only", RestrictedAgentMode::ReadOnly),
+        ] {
+            let args: SpawnAgentArgs = serde_json::from_value(serde_json::json!({
+                "message": "review", "task_name": "reviewer", "mode": mode,
+            }))
+            .unwrap();
+            assert_eq!(args.mode, Some(expected));
+        }
+        for mode in ["default", "auto", "full_access", ""] {
+            assert!(
+                serde_json::from_value::<SpawnAgentArgs>(serde_json::json!({
+                    "message": "review", "task_name": "reviewer", "mode": mode,
+                }))
+                .is_err()
+            );
