+#[cfg(test)]
+mod restriction_tests {
+    use super::*;
+    use codex_protocol::models::PermissionProfile;
+    use codex_protocol::permissions::FileSystemAccessMode;
+    use codex_protocol::permissions::FileSystemSandboxEntry;
+    use codex_protocol::permissions::FileSystemSandboxPolicy;
+    use codex_protocol::permissions::NetworkSandboxPolicy;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    #[test]
+    fn read_only_child_preserves_parent_denials() {
+        let dir = tempfile::tempdir().unwrap();
+        let root = AbsolutePathBuf::from_absolute_path(dir.path()).unwrap();
+        let denied = root.join("secret");
+        let mut fs = FileSystemSandboxPolicy::read_only();
+        fs.entries.push(FileSystemSandboxEntry::new(
+            denied.into(),
+            FileSystemAccessMode::Deny,
+        ));
+        let parent =
+            PermissionProfile::from_runtime_permissions(&fs, NetworkSandboxPolicy::Restricted);
+        let child =
+            read_only_profile(&parent, std::slice::from_ref(&root), root.as_path()).unwrap();
+        let child_fs = child.permission_profile().file_system_sandbox_policy();
+        assert!(!child_fs.has_full_disk_write_access());
+        assert!(
+            child_fs
+                .get_writable_roots_with_cwd(root.as_path())
+                .is_empty()
+        );
+        assert!(
+            child_fs
+                .entries
+                .iter()
+                .any(|entry| entry.access == FileSystemAccessMode::Deny)
+        );
+        let again = read_only_profile(
+            child.permission_profile(),
+            std::slice::from_ref(&root),
+            root.as_path(),
+        )
+        .unwrap();
+        assert_eq!(child, again);
+    }
+}
