+fn read_only_profile(
+    profile: &codex_protocol::models::PermissionProfile,
+    roots: &[codex_utils_absolute_path::AbsolutePathBuf],
+    cwd: &std::path::Path,
+) -> CodexResult<PermissionProfileSnapshot> {
+    let authority = profile
+        .clone()
+        .materialize_project_roots_with_workspace_roots(roots);
+    let restricted = intersect_effective_permission_profiles(
+        &authority,
+        &codex_protocol::models::PermissionProfile::read_only(),
+        cwd,
+    )
+    .map_err(|err| CodexErr::InvalidRequest(format!("Cannot restrict child permissions: {err}")))?;
+    Ok(PermissionProfileSnapshot::legacy(restricted))
+}
+
+fn restrict_child_to_read_only(options: &mut StartThreadOptions) -> CodexResult<()> {
+    if options
+        .inherited_environments
+        .as_ref()
+        .is_some_and(|snapshot| {
+            snapshot
+                .turn_environments()
+                .any(|environment| environment.environment.is_remote())
+        })
+    {
+        return Err(CodexErr::InvalidRequest(
+            "Read-only child mode requires local executors".into(),
+        ));
+    }
+    if options.environments.is_none() {
+        options.environments = options.inherited_environments.as_ref().map(|snapshot| {
+            snapshot
+                .inheritable_selections()
+                .into_iter()
+                .map(codex_protocol::protocol::TurnEnvironmentSelection::into_request)
+                .collect()
+        });
+    }
+    let profile = read_only_profile(
+        options.config.permissions.permission_profile(),
+        std::slice::from_ref(&options.config.cwd),
+        options.config.cwd.as_path(),
+    )?;
+    options
+        .config
+        .permissions
+        .set_permission_profile_from_session_snapshot(profile)
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    options
+        .config
+        .permissions
+        .approval_policy
+        .set(AskForApproval::Never)
+        .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+    for request in options.environments.iter_mut().flatten() {
+        if matches!(request.config, EnvironmentConfigState::FromThread) {
+            let config = options
+                .inherited_environments
+                .as_ref()
+                .and_then(|snapshot| {
+                    snapshot.turn_environments().find(|environment| {
+                        environment.selection.environment_id == request.environment_id
+                    })
+                })
+                .map(|environment| environment.config().clone())
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest(
+                        "Read-only child requires a ready inherited environment".into(),
+                    )
+                })?;
+            request.config = EnvironmentConfigState::Ready(config);
+        }
+        let EnvironmentConfigState::Ready(config) = &mut request.config else {
+            return Err(CodexErr::InvalidRequest(
+                "Read-only child requires ready environment bindings".into(),
+            ));
+        };
+        let cwd = request
+            .cwd
+            .to_abs_path()
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        let roots = request
+            .workspace_roots
+            .iter()
+            .map(PathUri::to_abs_path)
+            .collect::<std::result::Result<Vec<_>, _>>()
+            .map_err(|err| CodexErr::InvalidRequest(err.to_string()))?;
+        config.permission_profile =
+            read_only_profile(config.permission_profile.permission_profile(), &roots, &cwd)?;
+    }
+    Ok(())
+}
