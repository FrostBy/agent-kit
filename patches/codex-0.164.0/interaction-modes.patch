+#[tokio::test]
+async fn shift_tab_full_access_reaches_app_server() -> Result<()> {
+    boxed_future!(async {
+        let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+        let home = tempdir()?;
+        std::fs::write(
+            home.path().join("config.toml"),
+            "approval_policy = \"on-request\"\napprovals_reviewer = \"auto_review\"\nsandbox_mode = \"workspace-write\"\n",
+        )?;
+        let config = ConfigBuilder::default()
+            .codex_home(home.path().into())
+            .loader_overrides(codex_config::LoaderOverrides::without_managed_config_for_tests())
+            .build()
+            .await?;
+        let mut server = crate::start_embedded_app_server_for_picker(&config).await?;
+        let started = server.start_thread(&config).await?;
+        let thread_id = started.session.thread_id;
+        app.enqueue_primary_thread_session(started.session, started.turns)
+            .await?;
+
+        for expected in [ModeKind::Plan, ModeKind::Default, ModeKind::Plan] {
+            while events.try_recv().is_ok() {}
+            app.chat_widget.handle_key_event(KeyCode::BackTab.into());
+            let updates: Vec<_> = std::iter::from_fn(|| events.try_recv().ok())
+                .filter(|event| {
+                    matches!(event,
+                        AppEvent::SubmitThreadOp { .. } | AppEvent::SelectPermissionProfile(_)
+                    )
+                })
+                .collect();
+            assert_eq!(updates.len(), 1);
+            let AppEvent::SubmitThreadOp {
+                thread_id: target,
+                op,
+            } = &updates[0] else {
+                panic!("expected a combined settings update");
+            };
+            assert_eq!(*target, thread_id);
+            assert!(
+                app.try_submit_active_thread_op_via_app_server(&mut server, *target, op)
+                    .await?
+            );
+            let notification = next_thread_settings_updated(&mut server, thread_id).await;
+            assert_eq!(
+                notification.thread_settings.approval_policy,
+                AskForApproval::Never
+            );
+            assert_eq!(
+                notification.thread_settings.approvals_reviewer.to_core(),
+                ApprovalsReviewer::User
+            );
+            assert_eq!(
+                notification.thread_settings.sandbox_policy,
+                codex_app_server_protocol::SandboxPolicy::DangerFullAccess
+            );
+            assert_eq!(notification.thread_settings.collaboration_mode.mode, expected);
+            app.enqueue_thread_notification(
+                thread_id,
+                ServerNotification::ThreadSettingsUpdated(notification),
+            )
+            .await?;
+            assert_eq!(app.chat_widget.active_collaboration_mode_kind(), expected);
+            assert_eq!(
+                app.chat_widget.config_ref().permissions.approval_policy.value(),
+                AskForApproval::Never.to_core()
+            );
+            assert_eq!(
+                app.chat_widget.config_ref().permissions.permission_profile(),
+                &PermissionProfile::Disabled
+            );
+        }
+        server.shutdown().await?;
+        Ok(())
+    })
+    .await
+}
 
