+        if self.active_mode_kind() == ModeKind::Plan {
+            "plan"
+        } else {
+            let profile = self.config.permissions.permission_profile();
+            if self.config.permissions.approval_policy.value() == AskForApproval::Never.to_core()
+                && profile.file_system_sandbox_policy().has_full_disk_write_access()
+                && profile.network_sandbox_policy().is_enabled()
+            {
+                "auto"
+            } else if !profile
+                .file_system_sandbox_policy()
+                .has_full_disk_write_access()
+                && profile
+                    .file_system_sandbox_policy()
+                    .get_writable_roots_with_cwd(self.config.cwd.as_path())
+                    .is_empty()
+            {
+                "read-only"
+            } else {
+                "default"
+            }
+        }
+    }
