+    pub(super) fn status_line_mode(&self) -> &'static str {
+        if let Some(mode) = self.pending_interaction_mode {
+            return if mode == ModeKind::Plan { "plan" } else { "auto" };
+        }
+        if self.active_mode_kind() == ModeKind::Plan {
+            "plan"
+        } else {
+            let profile = self.config.permissions.permission_profile();
+            if self.config.permissions.approval_policy.value() == AskForApproval::Never.to_core()
+                && profile.file_system_sandbox_policy().has_full_disk_write_access()
+                && profile.network_sandbox_policy().is_enabled()
+            {
+                "auto"
+            } else if !profile
+                .file_system_sandbox_policy()
+                .has_full_disk_write_access()
+                && profile
+                    .file_system_sandbox_policy()
+                    .get_writable_roots_with_cwd(self.config.cwd.as_path())
+                    .is_empty()
+            {
+                "read-only"
+            } else {
+                "default"
+            }
+        }
+    }
+
+    /// User shortcut: Auto <-> Plan, both with Full Access.
+    pub(super) fn cycle_interaction_mode(&mut self) {
+        let current = self.pending_interaction_mode.unwrap_or_else(|| self.active_mode_kind());
+        let target = if current == ModeKind::Plan {
+            ModeKind::Default
+        } else {
+            ModeKind::Plan
+        };
+        self.apply_interaction_mode(target);
+    }
+
+    pub(super) fn apply_interaction_mode(&mut self, target: ModeKind) {
+        let Some(mut mask) = collaboration_modes::mask_for_kind(self.model_catalog.as_ref(), target)
+        else {
+            return;
+        };
+        let Some(preset) = builtin_approval_presets()
+            .into_iter()
+            .find(|p| p.id == "full-access")
+        else {
+            return;
+        };
+        let mut permissions = self.config.permissions.clone();
+        if let Err(err) = permissions.approval_policy.set(preset.approval) {
+            self.add_error_message(err.to_string());
+            return;
+        }
+        if let Err(err) = permissions.set_permission_profile_from_session_snapshot(
+            PermissionProfileSnapshot::active(
+                preset.permission_profile.clone(),
+                preset.active_permission_profile.clone(),
+            ),
+        ) {
+            self.add_error_message(err.to_string());
+            return;
+        }
+        if self.bottom_pane.is_task_running() {
+            self.pending_interaction_mode = Some(target);
+            self.status_line_command.last_requested_at = None;
+            self.refresh_status_surfaces();
+            self.request_redraw();
+            return;
+        }
+        self.config.permissions = permissions;
+        self.set_approvals_reviewer(ApprovalsReviewer::User);
+        self.status_line_command.last_requested_at = None;
+        // Shift+Tab keeps runtime choices instead of applying the Plan preset/config override.
+        mask.model = Some(self.current_model().to_string());
+        mask.reasoning_effort = Some(self.effective_reasoning_effort());
+        self.active_collaboration_mask = Some(mask);
+        self.update_collaboration_mode_indicator();
+        self.refresh_model_dependent_surfaces();
+        self.request_redraw();
+        // Send permissions and mode together; local state is already optimistic.
+        if let Some(thread_id) = self.thread_id {
+            self.app_event_tx.send(AppEvent::SubmitThreadOp {
+                thread_id,
+                op: AppCommand::override_turn_context(
+                    /*cwd*/ None,
+                    Some(AskForApproval::from(preset.approval)),
+                    Some(ApprovalsReviewer::User),
+                    Some(preset.permission_profile),
+                    Some(preset.active_permission_profile),
+                    /*model*/ None,
+                    /*effort*/ None,
+                    /*summary*/ None,
+                    /*service_tier*/ None,
+                    Some(self.effective_collaboration_mode()),
+                ),
+            });
+        } else {
+            for action in Self::approval_preset_actions(
+                AskForApproval::from(preset.approval),
+                preset.permission_profile,
+                preset.active_permission_profile,
+                preset.label.to_string(),
+                ApprovalsReviewer::User,
+            ) {
+                action(&self.app_event_tx);
+            }
+        }
+    }
