+#[tokio::test]
+async fn auto_survives_permission_events_and_server_profile() {
+    use codex_protocol::models::ManagedFileSystemPermissions;
+    use codex_protocol::permissions::NetworkSandboxPolicy;
+
+    let (mut chat, _sender, mut events, _operations) =
+        crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+    chat.config.permissions.set_permission_profile(PermissionProfile::workspace_write()).unwrap();
+    chat.cycle_interaction_mode();
+    chat.cycle_interaction_mode();
+    let mut applied = false;
+    while let Ok(event) = events.try_recv() {
+        match event {
+            AppEvent::UpdateAskForApprovalPolicy(policy) => chat.set_approval_policy(policy),
+            AppEvent::CodexOp(AppCommand::OverrideTurnContext { permission_profile: Some(profile), active_permission_profile, .. }) => {
+                chat.set_permission_profile_with_active_profile(profile, active_permission_profile).unwrap();
+                applied = true;
+            }
+            _ => {}
+        }
+    }
+    assert!(applied);
+    chat.set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::legacy(
+        PermissionProfile::Managed { file_system: ManagedFileSystemPermissions::Unrestricted, network: NetworkSandboxPolicy::Enabled },
+    )).unwrap();
+    assert_eq!(chat.status_line_mode(), "auto");
+    chat.set_approval_policy(AskForApproval::OnRequest);
+    assert_eq!(chat.status_line_mode(), "default");
+    chat.set_approval_policy(AskForApproval::Never);
+    chat.set_permission_profile_from_session_snapshot(PermissionProfileSnapshot::legacy(
+        PermissionProfile::Managed { file_system: ManagedFileSystemPermissions::Unrestricted, network: NetworkSandboxPolicy::Restricted },
+    )).unwrap();
+    assert_eq!(chat.status_line_mode(), "default");
+}
