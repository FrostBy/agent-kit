+#[tokio::test]
+async fn dictated_fragments_append_to_a_single_draft_without_a_turn_or_speech() {
+    let (mut chat, _sender, mut events, mut ops) = make_chatwidget_manual_with_sender().await;
+    activate_voice(&mut chat);
+    chat.realtime_conversation.dictation = true;
+    chat.bottom_pane.append_dictation("Existing draft", true);
+
+    chat.on_realtime_transcript_delta("user".into(), "first".into());
+    assert_eq!(chat.bottom_pane.composer_text(), "Existing draft first");
+    chat.on_realtime_transcript_delta("user".into(), " part".into());
+    assert_eq!(
+        chat.bottom_pane.composer_text(),
+        "Existing draft first part"
+    );
+    chat.on_realtime_transcript_done("assistant".into(), "Uh-huh".into());
+    chat.realtime_conversation.microphone_muted = true;
+    assert_eq!(
+        chat.bottom_pane.composer_text(),
+        "Existing draft first part"
+    );
+
+    chat.realtime_conversation.microphone_muted = false;
+    chat.realtime_conversation.dictation_new_segment = true;
+    chat.on_realtime_transcript_delta("user".into(), "second".into());
+    assert_eq!(
+        chat.bottom_pane.composer_text(),
+        "Existing draft first part second"
+    );
+    chat.on_realtime_transcript_done("user".into(), "first part.".into());
+    assert_eq!(
+        chat.bottom_pane.composer_text(),
+        "Existing draft first part second"
+    );
+    chat.on_realtime_transcript_done("user".into(), "second fragment".into());
+    assert_eq!(
+        chat.bottom_pane.composer_text(),
+        "Existing draft first part second fragment"
+    );
+    assert!(ops.try_recv().is_err());
+    assert!(
+        !std::iter::from_fn(|| events.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::InsertHistoryCell(_)))
+    );
+}
