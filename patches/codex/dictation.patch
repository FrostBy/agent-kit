+fn dictation_prefix_end(text: &str, partial: &str) -> Option<usize> {
+    if text.starts_with(partial) {
+        return Some(partial.len());
+    }
+    // A final may correct case and punctuation, including inside a prefix already sent.
+    let mut expected = partial
+        .chars()
+        .filter(|character| character.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .peekable();
+    expected.peek()?;
+    for (offset, character) in text
+        .char_indices()
+        .filter(|(_, character)| character.is_alphanumeric())
+    {
+        for actual in character.to_lowercase() {
+            if expected.next() != Some(actual) {
+                return None;
+            }
+        }
+        if expected.peek().is_none() {
+            return Some(offset + character.len_utf8());
+        }
+    }
+    None
+}
