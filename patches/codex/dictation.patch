+#[tokio::test]
+async fn dictation_keeps_showing_live_words_after_two_sends() {
+    use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+    let (mut chat, _sender, _events, mut ops) = make_chatwidget_manual_with_sender().await;
+    let thread_id = activate_voice(&mut chat);
+    chat.realtime_conversation.dictation = true;
+
+    let first = "Первое слово ".repeat(20).trim_end().to_string();
+    let second = format!(" {}", "Второе слово ".repeat(22).trim_end());
+    for (fragment, sent_immediately) in [(&first, true), (&second, false)] {
+        chat.on_realtime_transcript_delta("user".into(), fragment.clone());
+        assert_eq!(chat.bottom_pane.composer_text(), fragment.trim_start());
+        chat.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        assert_eq!(ops.try_recv().is_ok(), sent_immediately);
+        assert_eq!(chat.bottom_pane.composer_text(), "");
+    }
+    assert!(chat.input_queue.has_queued_follow_up_messages());
+
+    let third = "дальше идёт текст";
+    chat.on_realtime_transcript_delta("user".into(), format!(" {third}"));
+    assert_eq!(chat.bottom_pane.composer_text(), third);
+    finish_turn(&mut chat, thread_id, "first", vec![], TurnStatus::Completed);
+    assert!(!chat.input_queue.has_queued_follow_up_messages());
+    chat.on_realtime_transcript_done("user".into(), format!("{first}{second} {third}."));
+    assert_eq!(chat.bottom_pane.composer_text(), format!("{third}."));
+}
