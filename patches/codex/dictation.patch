+#[tokio::test]
+async fn muted_voice_keeps_the_acknowledgement_before_the_answer() {
+    let (mut chat, _sender, mut events, mut ops) = make_chatwidget_manual_with_sender().await;
+    let thread_id = activate_voice(&mut chat);
+    chat.toggle_realtime_agent_speaker();
+    assert!(chat.realtime_conversation.speaker_muted);
+    assert!(!chat.realtime_conversation.microphone_muted);
+    let turn_id = "voice-turn";
+    let delegation =
+        user_item("<realtime_delegation><input>my question</input></realtime_delegation>");
+    start_item(&mut chat, thread_id, turn_id, delegation.clone());
+    complete_item(&mut chat, thread_id, turn_id, delegation);
+    chat.on_realtime_transcript_delta("assistant".into(), "I'll take a look.".into());
+    let answer = agent_item(
+        "voice-answer",
+        "Answer in the chat",
+        Some(MessagePhase::FinalAnswer),
+    );
+    start_item(&mut chat, thread_id, turn_id, answer.clone());
+    complete_item(&mut chat, thread_id, turn_id, answer.clone());
+    finish_turn(
+        &mut chat,
+        thread_id,
+        turn_id,
+        vec![answer],
+        TurnStatus::Completed,
+    );
+    let AppCommand::RealtimeConversationSpeech {
+        delivery_id, text, ..
+    } = ops.try_recv().unwrap()
+    else {
+        panic!("muted voice should use the same answer delivery as unmuted voice");
+    };
+    assert_eq!(text.as_str(), "Answer in the chat");
+    chat.toggle_realtime_agent_speaker();
+    chat.toggle_realtime_agent_speaker();
+    assert!(chat.has_pending_realtime_speech(delivery_id));
+    chat.accept_realtime_speech(delivery_id);
+
+    chat.on_realtime_transcript_done("assistant".into(), "I'll take a look.".into());
+    chat.on_realtime_transcript_delta("assistant".into(), text.as_str().into());
+    chat.on_realtime_transcript_done("assistant".into(), text.as_str().into());
+    commit_realtime_history_events(&mut chat, &mut events);
+    let replies = std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::InsertHistoryCell(cell) => Some(cell.transcript_lines(80)),
+            _ => None,
+        })
+        .flatten()
+        .map(|line| line.to_string())
+        .filter(|line| line.contains("I'll take a look.") || line.contains("Answer in the chat"))
+        .collect::<Vec<_>>();
+    assert_eq!(replies, ["• I'll take a look.", "• Answer in the chat"]);
+    assert!(chat.realtime_conversation.speaker_muted);
+    assert!(chat.realtime_conversation.pending_speech.is_empty());
+    chat.toggle_realtime_agent_speaker();
+    assert!(!chat.realtime_conversation.speaker_muted);
+    assert!(chat.realtime_conversation_is_running());
+}
