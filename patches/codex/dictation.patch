+#[tokio::test]
+async fn speaker_mute_and_interruption_can_end_in_either_order() {
+    for unmute_first in [false, true] {
+        let (mut chat, _sender, _events, _ops) = make_chatwidget_manual_with_sender().await;
+        activate_voice(&mut chat);
+        chat.on_realtime_transcript_delta("assistant".into(), "Old answer".into());
+        chat.on_realtime_transcript_done("user".into(), "Correction".into());
+        chat.toggle_realtime_agent_speaker();
+        if unmute_first {
+            chat.toggle_realtime_agent_speaker();
+        }
+        chat.on_realtime_transcript_done("assistant".into(), "Old answer".into());
+        assert!(chat.realtime_conversation.speaker_suppressed());
+        chat.on_realtime_transcript_delta("assistant".into(), "New answer".into());
+        if !unmute_first {
+            assert!(chat.realtime_conversation.speaker_suppressed());
+            chat.toggle_realtime_agent_speaker();
+        }
+        assert!(!chat.realtime_conversation.speaker_suppressed());
+    }
+}
