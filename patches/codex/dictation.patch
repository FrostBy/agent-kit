+#[tokio::test]
+async fn dictation_restores_capture_once_without_losing_the_draft() {
+    use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+    for paused in [false, true] {
+        let (mut chat, _sender, mut events, _ops) = make_chatwidget_manual_with_sender().await;
+        let thread_id = activate_voice(&mut chat);
+        chat.realtime_conversation.dictation = true;
+        chat.realtime_conversation.session_lock = Some(SessionLock::observe(
+            thread_id,
+            chat.app_event_tx.clone(),
+            std::future::pending(),
+        ));
+        for text in ["first", " second"] {
+            chat.on_realtime_transcript_delta("user".into(), text.into());
+            chat.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+            assert_eq!(chat.bottom_pane.composer_text(), "");
+        }
+        chat.on_realtime_transcript_delta("user".into(), " Existing draft".into());
+        chat.realtime_conversation.microphone_muted = paused;
+
+        chat.on_realtime_conversation_closed(Some("transport_closed".into()));
+        assert_eq!(
+            chat.realtime_conversation.phase,
+            RealtimeConversationPhase::Starting
+        );
+        assert!(chat.realtime_conversation.dictation_retry_used);
+        assert_eq!(chat.realtime_conversation.microphone_muted, paused);
+        assert!(render_bottom_popup(&chat, 80).contains("reconnecting"));
+
+        chat.on_realtime_transcript_done("user".into(), "first second Existing draft".into());
+        assert_eq!(chat.bottom_pane.composer_text(), "Existing draft");
+        if paused {
+            chat.stop_realtime_conversation();
+            chat.on_realtime_conversation_closed(Some("transport_closed".into()));
+        } else {
+            let attempt = chat.realtime_conversation.attempt_id;
+            chat.on_realtime_conversation_started();
+            chat.on_realtime_webrtc_connected(attempt, Ok(()));
+            chat.on_realtime_transcript_delta("user".into(), "after reconnect".into());
+            assert!(!chat.realtime_conversation.dictation_retry_used);
+            assert_eq!(
+                chat.bottom_pane.composer_text(),
+                "Existing draft after reconnect"
+            );
+
+            chat.on_realtime_conversation_closed(Some("transport_closed".into()));
+            assert_eq!(
+                chat.realtime_conversation.phase,
+                RealtimeConversationPhase::Starting
+            );
+            chat.on_realtime_conversation_closed(Some("transport_closed".into()));
+            commit_realtime_history_events(&mut chat, &mut events);
+            assert!(std::iter::from_fn(|| events.try_recv().ok()).any(|event| {
+                matches!(event, AppEvent::InsertHistoryCell(cell) if cell.transcript_lines(80)
+                    .iter().any(|line| line.to_string().contains("f9 to restart dictation")))
+            }));
+        }
+        assert_eq!(
+            chat.realtime_conversation.phase,
+            RealtimeConversationPhase::Inactive
+        );
+        assert!(
+            chat.bottom_pane
+                .composer_text()
+                .starts_with("Existing draft")
+        );
+    }
+}
