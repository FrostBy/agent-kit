+#[test]
+fn speaker_hint_matches_configured_binding_and_yields_to_mic_binding() {
+    let mut strip = active_strip();
+    for (setting, expected) in [
+        ("toggle_voice_speaker_mute = 'ctrl-x s'", "⌃x s mute agent"),
+        ("toggle_voice_speaker_mute = []", ""),
+        ("toggle_voice_mute = 'f10'", ""),
