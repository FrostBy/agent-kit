+    ] {
+        let config = toml::from_str(&format!("[chat]\n{setting}")).unwrap();
+        let keymap = crate::keymap::RuntimeKeymap::from_config(&config).unwrap();
+        strip.state.mute_hint = keymap.chat.voice_mute_hint();
+        strip.state.speaker_mute_hint = keymap.chat.voice_speaker_mute_hint();
+        let (text, _) = rows(&strip, 80);
+        let status = text.lines().next().unwrap();
+        assert_eq!(status.split_once("/voice stop").unwrap().1.trim(), expected);
