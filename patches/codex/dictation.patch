+#[test]
+fn dictation_hint_uses_configured_binding_and_availability() {
+    let config =
+        toml::from_str("[chat]\ntoggle_voice_mute = 'ctrl-x m'\ntoggle_voice = 'ctrl-x v'")
+            .unwrap();
+    let keymap = RuntimeKeymap::from_config(&config).unwrap();
+    let (mut composer, _rx) = new_test_composer();
+    composer.set_keymap_bindings(&keymap);
+    assert_eq!(composer.footer_props().key_hints.dictate, None);
+    composer.set_voice_command_enabled(true);
+    assert_eq!(
+        composer
+            .footer_props()
+            .key_hints
+            .dictate
+            .unwrap()
+            .display_label(),
+        "⌃x m"
+    );
+    let area = Rect::new(0, 0, 100, composer.desired_height(100));
+    let mut buffer = Buffer::empty(area);
+    composer.render(area, &mut buffer);
+    let rendered = buffer
+        .content
+        .iter()
+        .map(ratatui::buffer::Cell::symbol)
+        .collect::<String>();
+    assert!(rendered.contains("⌃x m dictate"));
+    assert!(rendered.contains("⌃x v voice"));
+    assert!(rendered.contains("? for shortcuts"));
+    composer.side_conversation_active = true;
+    assert_eq!(composer.footer_props().key_hints.dictate, None);
+}
