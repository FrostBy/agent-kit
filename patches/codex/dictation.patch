+#[tokio::test]
+async fn sending_dictation_keeps_recording_without_repeating_the_sent_prefix() {
+    use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};
+    for muted in [false, true] {
+        let (mut chat, _sender, _events, mut ops) = make_chatwidget_manual_with_sender().await;
+        activate_voice(&mut chat);
+        chat.realtime_conversation.dictation = true;
+        chat.on_realtime_transcript_delta("user".into(), "первое сообщение".into());
+        chat.realtime_conversation.microphone_muted = muted;
+
+        chat.handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        let AppCommand::UserTurn { items, .. } = ops.try_recv().unwrap() else {
+            panic!("Enter should send the draft before the final transcript arrives");
+        };
+        assert!(matches!(&items[..], [UserInput::Text { text, .. }] if text == "первое сообщение"));
+        assert_eq!(chat.realtime_conversation.microphone_muted, muted);
+        assert_eq!(chat.bottom_pane.composer_text(), "");
+
+        chat.on_realtime_transcript_delta("user".into(), " второе".into());
+        assert_eq!(chat.bottom_pane.composer_text(), "второе");
+        chat.on_realtime_transcript_done("user".into(), "Первое сообщение, второе дальше.".into());
+        assert_eq!(chat.bottom_pane.composer_text(), "второе дальше.");
+        assert!(ops.try_recv().is_err());
+    }
+}
