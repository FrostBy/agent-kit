+    chat.set_status_line_agent_status(&id, &ThreadStatus::Idle);
+    if let codex_app_server_protocol::ThreadItemPayload::SubAgentActivity { kind, .. } = &mut item.payload {
+        *kind = codex_app_server_protocol::SubAgentActivityKind::Completed;
