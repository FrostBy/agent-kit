+    #[tokio::test]
+    async fn agent_tree_shows_peers_children_and_collapsed_descendant_counts() {
+        let mut app = crate::app::test_support::make_test_app().await;
+        let main = ThreadId::new();
+        let review = ThreadId::new();
+        let check = ThreadId::new();
+        let fix = ThreadId::new();
+        let scan = ThreadId::new();
+        let validate = ThreadId::new();
+        let audit = ThreadId::new();
+        app.primary_thread_id = Some(main);
+        app.active_thread_id = Some(main);
+        let view = Rect::new(0, 0, 40, 24);
+        assert!(app.agent_tree(view).is_empty());
+        for (id, path) in [
+            (review, "/root/review"),
+            (check, "/root/check"),
+            (fix, "/root/review/修正"),
+            (scan, "/root/review/scan"),
+            (validate, "/root/review/修正/validate"),
+            (audit, "/root/check/audit"),
+        ] {
+            app.agent_navigation.upsert(id, None, None, false);
+            app.agent_navigation.mark_running(id);
+            app.agent_navigation.set_agent_path(id, Some(path.into()));
+        }
+        app.agent_navigation.set_parent(check, Some(main));
+        app.agent_navigation.mark_running(review);
+        let labels = |app: &App| {
+            app.agent_tree(view)
+                .iter()
+                .map(|(id, line)| (*id, line.to_string()))
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(
+            labels(&app),
+            [
+                (Some(main), "● main".into()),
+                (Some(review), "○ review (+3)".into()),
+                (Some(check), "○ check (+1)".into()),
+            ]
+        );
+        app.active_thread_id = Some(review);
+        assert_eq!(
+            labels(&app),
+            [
+                (Some(main), "○ main".into()),
+                (Some(review), "● review".into()),
+                (Some(fix), "├─ ○ 修正 (+1)".into()),
+                (Some(scan), "└─ ○ scan".into()),
+                (Some(check), "○ check (+1)".into()),
+            ]
+        );
+        app.active_thread_id = Some(fix);
+        assert_eq!(
+            labels(&app),
+            [
+                (Some(main), "○ main".into()),
+                (Some(review), "○ review".into()),
+                (Some(fix), "├─ ● 修正".into()),
+                (Some(validate), "  └─ ○ validate".into()),
+                (Some(scan), "└─ ○ scan".into()),
+            ]
+        );
+        let short = app.agent_tree(Rect { height: 6, ..view });
+        assert_eq!(
+            short.iter().map(|(id, _)| *id).collect::<Vec<_>>(),
+            [Some(main), Some(fix), None]
+        );
+
+        let rows = app.agent_tree(view);
+        let conversation = Rect { height: 19, ..view };
+        let mut buffer = Buffer::empty(view);
+        let pointer = Position::new(10, 22);
+        app.conversation_frame.agent_tree = paint(&rows, conversation, Some(pointer), &mut buffer);
+        assert_eq!(app.agent_tree_target(Some(pointer)), Some(validate));
+        assert_eq!(
+            app.agent_tree_target(Some(Position::new(1, 19))),
+            Some(main)
+        );
+        assert_eq!(app.agent_tree_target(Some(Position::new(28, 22))), None);
+        let hovered = buffer[pointer].clone();
+        let marker = &buffer[(1, 20)];
+        let name = &buffer[(3, 20)];
+        assert_eq!(marker.symbol(), "○");
+        assert_eq!(marker.fg, name.fg);
+        assert_eq!(marker.modifier, name.modifier);
+        assert!(!marker.modifier.contains(Modifier::BOLD));
+        assert_ne!(marker.fg, Color::Green);
+        let selected = &buffer[(4, 21)];
+        assert_eq!(selected.symbol(), "●");
+        assert!(selected.modifier.contains(Modifier::BOLD));
+        assert!(marker.fg != selected.fg || marker.modifier.contains(Modifier::DIM));
+        buffer.reset();
+        paint(&rows, conversation, None, &mut buffer);
+        assert!(buffer[pointer].bg != hovered.bg || buffer[pointer].modifier != hovered.modifier);
+
+        app.primary_thread_id = Some(ThreadId::new());
+        assert_eq!(app.agent_tree_target(Some(pointer)), None);
+    }
