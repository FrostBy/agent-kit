+        assert_eq!(payload["activity"]["agents"], 1);
+        assert_eq!(
+            payload["activity"]["agent_attention"],
+            serde_json::json!([{"name": "reviewer", "status": expected}])
+        );
+    }
+    chat.set_status_line_agent_status(
+        &id,
+        &ThreadStatus::Active {
+            active_flags: vec![],
+        },
+    );
+    assert!(chat.status_line_agent_attention().is_empty());
+    chat.set_status_line_agent_turn(&id, &TurnStatus::Failed);
+    chat.set_status_line_agent_status(&id, &ThreadStatus::Idle);
+    if let codex_app_server_protocol::ThreadItemPayload::SubAgentActivity { kind, .. } =
+        &mut item.payload
+    {
+        *kind = codex_app_server_protocol::SubAgentActivityKind::Completed;
+    }
+    chat.observe_status_line_item(&item, false);
+    assert_eq!(
+        chat.status_line_agent_attention()[0].status,
+        AgentAttentionKind::Failed
+    );
+    chat.set_status_line_agent_turn(&id, &TurnStatus::Completed);
+    assert!(chat.status_line_agent_attention().is_empty());
+    chat.set_status_line_agent_status(&id, &ThreadStatus::SystemError);
+    chat.set_status_line_agent_status(
+        &id,
+        &ThreadStatus::Active {
+            active_flags: vec![],
+        },
+    );
+    assert!(chat.status_line_agent_attention().is_empty());
+    chat.set_status_line_agent_status(&id, &ThreadStatus::SystemError);
+    chat.remove_status_line_agent(&id);
+    chat.set_status_line_agent_status("unrelated", &ThreadStatus::SystemError);
+    assert!(chat.status_line_agent_attention().is_empty());
+    assert!(chat.status_line_command.agents.is_empty());
+}
