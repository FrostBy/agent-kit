+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(crate) struct PassiveFooterLayout {
+    lines: Vec<Line<'static>>,
+    right_indicator: Option<Line<'static>>,
+}
+
+impl PassiveFooterLayout {
+    pub(crate) fn height(&self) -> u16 {
+        self.lines.len().try_into().unwrap_or(u16::MAX)
+    }
+
+    pub(crate) fn lines(&self) -> &[Line<'static>] {
+        &self.lines
+    }
+
+    pub(crate) fn right_indicator(&self) -> Option<&Line<'static>> {
+        self.right_indicator.as_ref()
+    }
+
+    pub(crate) fn is_single_status_row(&self) -> bool {
+        self.lines.len() == 1
+    }
+
+    #[cfg(test)]
+    fn plain_lines(&self) -> Vec<String> {
+        self.lines
+            .iter()
+            .map(|line| {
+                line.spans
+                    .iter()
+                    .map(|span| span.content.as_ref())
+                    .collect()
+            })
+            .collect()
+    }
+}
+
+pub(crate) fn passive_footer_layout(
+    status: Option<&StatusLine>,
+    area_width: u16,
+    right_indicator: Option<Line<'static>>,
+) -> PassiveFooterLayout {
+    let full_width = area_width.saturating_sub(FOOTER_INDENT_COLS as u16);
+    let mut lines = status
+        .map(|status| status.layout(usize::from(full_width)))
+        .unwrap_or_default();
+    if lines.is_empty() {
+        lines.push(Line::default());
+    }
+
+    if let Some(indicator) = right_indicator.as_ref() {
+        let area = Rect::new(/*x*/ 0, /*y*/ 0, area_width, /*height*/ 1);
+        let final_width = lines
+            .last()
+            .map(Line::width)
+            .and_then(|width| width.try_into().ok())
+            .unwrap_or(u16::MAX);
+        let indicator_width = indicator.width().try_into().unwrap_or(u16::MAX);
+        if !can_show_left_with_context(area, final_width, indicator_width) {
+            let reflowed = status.and_then(|status| {
+                let max_left = max_left_width_for_right(area, indicator_width)?;
+                status.layout_with_last_width(usize::from(full_width), usize::from(max_left))
+            });
+            if let Some(reflowed) = reflowed {
+                lines = reflowed;
+            } else {
+                lines.push(Line::default());
+            }
+        }
+    }
+
+    PassiveFooterLayout {
+        lines,
+        right_indicator,
+    }
+}
+
+pub(crate) fn passive_footer_layout_with_indicator_fallback(
+    status: Option<&StatusLine>,
+    area_width: u16,
+    full_indicator: Option<Line<'static>>,
+    compact_indicator: Option<Line<'static>>,
+) -> PassiveFooterLayout {
+    let has_full_indicator = full_indicator.is_some();
+    let full_layout = passive_footer_layout(status, area_width, full_indicator);
+    let full_requires_dedicated_row = has_full_indicator
+        && full_layout.lines().len() > 1
+        && full_layout
+            .lines()
+            .last()
+            .is_some_and(|line| line.width() == 0);
+    if full_requires_dedicated_row {
+        passive_footer_layout(status, area_width, compact_indicator)
+    } else {
+        full_layout
+    }
+}
+
+pub(crate) fn render_passive_footer(area: Rect, buf: &mut Buffer, layout: &PassiveFooterLayout) {
+    Paragraph::new(prefix_lines(
+        layout.lines().to_vec(),
+        " ".repeat(FOOTER_INDENT_COLS).into(),
+        " ".repeat(FOOTER_INDENT_COLS).into(),
+    ))
+    .render(area, buf);
+    if let Some(indicator) = layout.right_indicator.as_ref() {
+        render_context_right(area, buf, indicator);
+    }
+}
