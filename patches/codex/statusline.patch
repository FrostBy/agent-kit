diff --git a/codex-rs/tui/src/app/agent_tree.rs b/codex-rs/tui/src/app/agent_tree.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/app/agent_tree.rs
@@ -0,0 +1,860 @@
+use super::App;
+use codex_app_server_protocol::ServerNotification;
+use codex_app_server_protocol::SubAgentActivityKind;
+use codex_app_server_protocol::ThreadActiveFlag;
+use codex_app_server_protocol::ThreadItemPayload;
+use codex_app_server_protocol::ThreadStatus;
+use codex_app_server_protocol::TurnStatus;
+use codex_protocol::ThreadId;
+use codex_utils_elapsed::format_duration;
+use ratatui::buffer::Buffer;
+use ratatui::layout::Position;
+use ratatui::layout::Rect;
+use ratatui::style::Color;
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::text::Span;
+use ratatui::widgets::Widget;
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::time::Duration;
+use std::time::Instant;
+
+const COMPLETION_GRACE: Duration = Duration::from_secs(30);
+const FINISHED_AGENTS_HINT: &str = "/subagents to see finished agents";
+
+#[derive(Debug, Default)]
+pub(super) struct AgentTreeActivity {
+    started: Option<Instant>,
+    finished: Option<(TurnStatus, Instant)>,
+    summary: Option<String>,
+    tokens: Option<i64>,
+    waiting: Option<&'static str>,
+}
+
+impl AgentTreeActivity {
+    fn finish(&mut self, status: TurnStatus, now: Instant) -> bool {
+        if status == TurnStatus::InProgress
+            || self
+                .finished
+                .as_ref()
+                .is_some_and(|(previous, _)| *previous == status)
+        {
+            return false;
+        }
+        self.finished = Some((status, now));
+        self.waiting = None;
+        true
+    }
+
+    fn metrics(&self, now: Instant) -> String {
+        let mut parts = Vec::new();
+        if let Some(waiting) = self.waiting {
+            parts.push(waiting.into());
+        }
+        if let Some((status, _)) = &self.finished {
+            match status {
+                TurnStatus::Failed => parts.push("failed".into()),
+                TurnStatus::Interrupted => parts.push("stopped".into()),
+                _ => {}
+            }
+        }
+        if let Some(started) = self.started {
+            let end = self.finished.as_ref().map_or(now, |(_, ended)| *ended);
+            parts.push(format_duration(end.saturating_duration_since(started)));
+        }
+        if let Some(tokens) = self.tokens.filter(|tokens| *tokens > 0) {
+            parts.push(format!(
+                "{} tokens",
+                crate::status::format_tokens_compact(tokens)
+            ));
+        }
+        parts.join(" · ")
+    }
+}
+
+impl App {
+    pub(super) fn update_agent_tree_activity(
+        &mut self,
+        id: ThreadId,
+        notification: &ServerNotification,
+        turn_stopped: bool,
+    ) {
+        if self.primary_thread_id == Some(id) || self.side_threads.contains_key(&id) {
+            return;
+        }
+        let Some(entry) = self.agent_navigation.get(&id) else {
+            return;
+        };
+        let running = entry.is_running;
+        let now = Instant::now();
+        let liveness_changed = if let ServerNotification::ThreadStatusChanged(event) = notification
+        {
+            // A newly attached TUI can see status notifications before it watches a child turn.
+            let reported_running = matches!(event.status, ThreadStatus::Active { .. });
+            if running != reported_running {
+                if reported_running {
+                    self.agent_navigation.mark_running(id);
+                } else {
+                    self.agent_navigation.mark_stopped(id);
+                }
+                self.agent_navigation
+                    .get(&id)
+                    .is_some_and(|entry| entry.is_running != running)
+            } else {
+                false
+            }
+        } else {
+            false
+        };
+        let state = self.agent_navigation.tree_activity.entry(id).or_default();
+        if liveness_changed && !running {
+            state.started = Some(now);
+            state.finished = None;
+            state.summary = None;
+            state.waiting = None;
+        }
+        let redraw = match notification {
+            ServerNotification::TurnStarted(event) => {
+                state.started = Some(
+                    event
+                        .turn
+                        .started_at
+                        .and_then(|started| chrono::Utc::now().timestamp().checked_sub(started))
+                        .and_then(|seconds| u64::try_from(seconds).ok())
+                        .and_then(|seconds| now.checked_sub(Duration::from_secs(seconds)))
+                        .unwrap_or(now),
+                );
+                state.finished = None;
+                state.summary = None;
+                state.waiting = None;
+                true
+            }
+            ServerNotification::TurnCompleted(event) if turn_stopped => {
+                state.finish(event.turn.status.clone(), now)
+            }
+            ServerNotification::ThreadStatusChanged(event) => {
+                if matches!(event.status, ThreadStatus::SystemError)
+                    && running
+                    && state.finished.is_none()
+                {
+                    state.finish(TurnStatus::Failed, now)
+                } else {
+                    let waiting = match &event.status {
+                        ThreadStatus::Active { active_flags }
+                            if active_flags.contains(&ThreadActiveFlag::WaitingOnApproval) =>
+                        {
+                            Some("awaiting approval")
+                        }
+                        ThreadStatus::Active { active_flags }
+                            if active_flags.contains(&ThreadActiveFlag::WaitingOnUserInput) =>
+                        {
+                            Some("awaiting input")
+                        }
+                        _ => None,
+                    };
+                    let changed = state.waiting != waiting;
+                    state.waiting = waiting;
+                    changed
+                }
+            }
+            ServerNotification::ThreadTokenUsageUpdated(event) => {
+                let tokens = Some(event.token_usage.total.total_tokens);
+                let changed = state.tokens != tokens;
+                state.tokens = tokens;
+                changed
+            }
+            ServerNotification::ItemStarted(event) => {
+                Self::update_agent_tree_summary(state, &event.item.payload)
+            }
+            ServerNotification::ItemCompleted(event) => {
+                Self::update_agent_tree_summary(state, &event.item.payload)
+            }
+            _ => false,
+        };
+        if redraw || liveness_changed {
+            self.chat_widget.request_redraw();
+        }
+    }
+
+    fn update_agent_tree_summary(state: &mut AgentTreeActivity, item: &ThreadItemPayload) -> bool {
+        let summary = match item {
+            ThreadItemPayload::CommandExecution { .. } => Some("Shell command".into()),
+            _ => super::agent_status_feed::activity_summary(item),
+        };
+        let Some(summary) = summary else {
+            return false;
+        };
+        let summary = summary.replace(char::is_control, " ");
+        if state.summary.as_deref() == Some(summary.as_str()) {
+            return false;
+        }
+        state.summary = Some(summary);
+        true
+    }
+
+    pub(super) fn update_agent_tree_spawn_activity(
+        &mut self,
+        id: ThreadId,
+        item: &ThreadItemPayload,
+    ) {
+        let ThreadItemPayload::SubAgentActivity { kind, .. } = item else {
+            return;
+        };
+        let running = self
+            .agent_navigation
+            .get(&id)
+            .is_some_and(|entry| entry.is_running);
+        let now = Instant::now();
+        let state = self.agent_navigation.tree_activity.entry(id).or_default();
+        match kind {
+            SubAgentActivityKind::Started if running => {
+                state.started.get_or_insert(now);
+            }
+            SubAgentActivityKind::Completed if state.finished.is_none() => {
+                state.finish(TurnStatus::Completed, now);
+            }
+            SubAgentActivityKind::Interrupted if state.finished.is_none() => {
+                state.finish(TurnStatus::Interrupted, now);
+            }
+            _ => {}
+        }
+    }
+
+    pub(super) fn agent_tree_update_delay(&self, now: Instant) -> Option<Duration> {
+        if self.overlay.is_some() || !self.chat_widget.no_modal_or_popup_active() {
+            return None;
+        }
+        let navigation = &self.agent_navigation;
+        navigation
+            .tree_activity
+            .iter()
+            .filter_map(|(id, state)| {
+                if let Some((_, ended)) = state.finished.as_ref() {
+                    let expires = *ended + COMPLETION_GRACE;
+                    return (expires > now).then(|| expires - now);
+                }
+                navigation
+                    .get(id)
+                    .is_some_and(|entry| entry.is_running && !entry.is_closed)
+                    .then_some(Duration::from_secs(1))
+            })
+            .min()
+    }
+
+    pub(super) fn agent_tree(&self, area: Rect) -> Vec<(Option<ThreadId>, Line<'static>)> {
+        let Some(main) = self.primary_thread_id else {
+            return Vec::new();
+        };
+        if area.width < 8
+            || area.height < 6
+            || self.overlay.is_some()
+            || !self.chat_widget.no_modal_or_popup_active()
+        {
+            return Vec::new();
+        }
+
+        let navigation = &self.agent_navigation;
+        let current = self.current_displayed_thread_id();
+        let agents: Vec<_> = navigation
+            .visible_threads()
+            .into_iter()
+            .filter(|(id, _)| *id != main && !self.side_threads.contains_key(id))
+            .collect();
+        let paths: HashMap<_, _> = agents
+            .iter()
+            .filter_map(|(id, entry)| Some((entry.agent_path.as_deref()?, *id)))
+            .collect();
+        let root_path = navigation
+            .get(&main)
+            .and_then(|entry| entry.agent_path.as_deref())
+            .unwrap_or("/root");
+
+        let mut parents = HashMap::new();
+        for &(id, entry) in &agents {
+            let parent = navigation.parent(id).or_else(|| {
+                // V2 activity can arrive before the thread metadata with its parent ID.
+                let (path, _) = entry.agent_path.as_deref()?.rsplit_once('/')?;
+                if path == root_path {
+                    Some(main)
+                } else {
+                    paths.get(path).copied()
+                }
+            });
+            if let Some(parent) = parent
+                && parent != id
+            {
+                parents.insert(id, parent);
+            }
+        }
+
+        let mut path = vec![current.unwrap_or(main)];
+        while *path.last().unwrap_or(&main) != main {
+            let Some(parent) = parents.get(path.last().unwrap_or(&main)).copied() else {
+                break;
+            };
+            if path.contains(&parent) {
+                break;
+            }
+            path.push(parent);
+        }
+        if path.last() != Some(&main) {
+            path = vec![main];
+        }
+        path.reverse();
+
+        let now = Instant::now();
+        let visible: HashSet<_> = agents
+            .iter()
+            .filter(|(id, entry)| {
+                let finished = navigation
+                    .tree_activity
+                    .get(id)
+                    .and_then(|state| state.finished.as_ref());
+                let active = finished.is_none() && entry.is_running && !entry.is_closed;
+                let grace = finished.is_some_and(|(status, ended)| {
+                    *status != TurnStatus::Completed
+                        && now.saturating_duration_since(*ended) < COMPLETION_GRACE
+                });
+                active || grace || path.contains(id) || navigation.pending_approvals.contains(id)
+            })
+            .map(|(id, _)| *id)
+            .collect();
+        let mut children = HashMap::<ThreadId, Vec<ThreadId>>::new();
+        for (id, _) in agents {
+            if !visible.contains(&id) {
+                continue;
+            }
+            // A running descendant remains reachable when its parent leaves the footer.
+            let parent = std::iter::successors(parents.get(&id).copied(), |parent| {
+                parents.get(parent).copied()
+            })
+            .take(parents.len())
+            .find(|parent| *parent == main || visible.contains(parent));
+            if let Some(parent) = parent {
+                children.entry(parent).or_default().push(id);
+            }
+        }
+        let hint = navigation.tree_activity.values().any(|state| {
+            state.finished.as_ref().is_some_and(|(status, ended)| {
+                *status == TurnStatus::Completed
+                    && now.saturating_duration_since(*ended) < COMPLETION_GRACE
+            })
+        });
+
+        let width = usize::from(area.width - 2);
+        let fit = |line, width| {
+            crate::line_truncation::truncate_line_with_ellipsis_if_overflow(line, width)
+        };
+        let secondary = crate::style::secondary_text_style();
+        let secondary = if secondary.fg == Some(Color::Reset) {
+            secondary.dim()
+        } else {
+            secondary
+        };
+        let style_row = |line: Line<'static>, id| {
+            let line = if current == Some(id) {
+                line.bold()
+            } else {
+                line.style(secondary)
+            };
+            if navigation.pending_approvals.contains(&id)
+                || navigation
+                    .tree_activity
+                    .get(&id)
+                    .is_some_and(|state| state.waiting.is_some())
+            {
+                line.yellow()
+            } else {
+                line
+            }
+        };
+        let hint_row = || {
+            (
+                None,
+                fit(Line::raw(FINISHED_AGENTS_HINT), width).style(secondary),
+            )
+        };
+        if !children.contains_key(&main) {
+            return if hint { vec![hint_row()] } else { Vec::new() };
+        }
+        let row = |id, depth: usize, last, expanded| {
+            let branch = if depth == 0 {
+                ""
+            } else if last {
+                "└─ "
+            } else {
+                "├─ "
+            };
+            let indent = " ".repeat((depth.saturating_sub(1) * 2).min(width.saturating_sub(8)));
+            let mark = if current == Some(id) { "●" } else { "○" };
+            let count = if expanded {
+                0
+            } else {
+                descendant_count(id, &children)
+            };
+            let suffix = if count > 0 {
+                format!(" (+{count})")
+            } else {
+                String::new()
+            };
+            let mut line = Line::raw(format!(
+                "{indent}{branch}{mark} {}",
+                self.agent_tree_label(id)
+            ));
+            let state = navigation.tree_activity.get(&id);
+            let metrics = state.map_or_else(String::new, |state| state.metrics(now));
+            let metrics_width = Line::raw(metrics.as_str()).width();
+            let show_metrics = metrics_width > 0 && metrics_width + suffix.len() + 10 <= width;
+            let label_width = if show_metrics {
+                width - metrics_width - 2
+            } else {
+                width
+            };
+            if suffix.len() + 1 < label_width {
+                line = fit(line, label_width - suffix.len());
+                if !suffix.is_empty() {
+                    line.spans.push(Span::raw(suffix));
+                }
+            } else {
+                line = fit(line, label_width);
+            }
+            if let Some(summary) = state.and_then(|state| state.summary.as_deref())
+                && line.width() + 6 <= label_width
+            {
+                let summary = fit(
+                    Line::raw(format!("  {summary}")),
+                    label_width - line.width(),
+                );
+                line.spans.extend(summary.spans);
+            }
+            if show_metrics {
+                let gap = width - metrics_width - line.width();
+                line.spans
+                    .push(Span::raw(format!("{}{metrics}", " ".repeat(gap))));
+            }
+            (Some(id), style_row(line, id))
+        };
+
+        let root = if current == Some(main) {
+            "● main"
+        } else {
+            "○ main"
+        };
+        let mut rows = vec![(Some(main), style_row(Line::raw(root), main))];
+        let focused = path.pop().unwrap_or(main);
+        let parent = path.last().copied().unwrap_or(main);
+        let depth = path.len().saturating_sub(1);
+        for (depth, ancestor) in path.into_iter().skip(1).enumerate() {
+            rows.push(row(ancestor, depth, true, true));
+        }
+        let peers = children.get(&parent).map(Vec::as_slice).unwrap_or_default();
+        for (index, &id) in peers.iter().enumerate() {
+            let last = index + 1 == peers.len();
+            rows.push(row(id, depth, last, id == focused));
+            if id == focused
+                && let Some(items) = children.get(&id)
+            {
+                for (index, &child) in items.iter().enumerate() {
+                    rows.push(row(child, depth + 1, index + 1 == items.len(), false));
+                }
+            }
+        }
+
+        let max_rows = usize::from((area.height / 3).max(3));
+        if rows.len() > max_rows {
+            let focused_index = rows
+                .iter()
+                .position(|(id, _)| *id == Some(focused))
+                .unwrap_or(0);
+            // Keep main and the focused row accessible in a short terminal.
+            let skipped = focused_index.saturating_sub(max_rows - 2);
+            rows.drain(1..1 + skipped);
+            rows.truncate(max_rows - 1);
+            rows.push((None, fit(Line::raw("… /subagents"), width).dim()));
+        } else if hint && rows.len() < max_rows {
+            rows.push(hint_row());
+        }
+        rows
+    }
+
+    fn agent_tree_label(&self, id: ThreadId) -> String {
+        self.agent_navigation
+            .get(&id)
+            .and_then(|entry| entry.agent_path.as_deref())
+            .and_then(|path| path.rsplit_once('/').map(|(_, name)| name))
+            .filter(|name| !name.is_empty())
+            .map(str::to_owned)
+            .unwrap_or_else(|| self.thread_label(id))
+            .replace(char::is_control, " ")
+    }
+
+    pub(super) fn agent_tree_target(&self, point: Option<Position>) -> Option<ThreadId> {
+        let point = point?;
+        let rows = &self.conversation_frame.agent_tree;
+        let (_, main) = rows.first()?;
+        if self.primary_thread_id != Some(*main)
+            || self.overlay.is_some()
+            || !self.chat_widget.no_modal_or_popup_active()
+            || self.transcript_view.is_select_mode()
+        {
+            return None;
+        }
+        rows.iter()
+            .find_map(|(area, id)| area.contains(point).then_some(*id))
+    }
+}
+
+fn descendant_count(id: ThreadId, children: &HashMap<ThreadId, Vec<ThreadId>>) -> usize {
+    let mut pending = vec![id];
+    let mut count = 0;
+    while let Some(parent) = pending.pop() {
+        if let Some(items) = children.get(&parent) {
+            count += items.len();
+            pending.extend_from_slice(items);
+        }
+    }
+    count
+}
+
+pub(super) fn paint(
+    rows: &[(Option<ThreadId>, Line<'static>)],
+    conversation: Rect,
+    pointer: Option<Position>,
+    buffer: &mut Buffer,
+) -> Vec<(Rect, ThreadId)> {
+    rows.iter()
+        .enumerate()
+        .filter_map(|(index, (thread, line))| {
+            let area = Rect::new(
+                conversation.x + 1,
+                conversation.bottom() + index as u16,
+                (line.width() as u16).min(conversation.width.saturating_sub(2)),
+                1,
+            );
+            if thread.is_some() && pointer.is_some_and(|point| area.contains(point)) {
+                line.clone()
+                    .style(crate::style::hover_style(line.style))
+                    .render(area, buffer);
+            } else {
+                line.render(area, buffer);
+            }
+            thread.map(|id| (area, id))
+        })
+        .collect()
+}
