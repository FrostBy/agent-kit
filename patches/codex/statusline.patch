diff --git a/codex-rs/tui/src/chatwidget/status_line_command.rs b/codex-rs/tui/src/chatwidget/status_line_command.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/status_line_command.rs
@@ -0,0 +1,682 @@
+use super::*;
+use codex_app_server_protocol::ThreadItem;
+use codex_config::types::TuiStatusLineCommand;
+use serde::Serialize;
+use std::process::Stdio;
+use std::sync::OnceLock;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+
+const MAX_CAPTURE_BYTES: usize = 32 * 1024;
+const MAX_RENDERED_LINES: usize = 32;
+const MIN_REFRESH_INTERVAL: Duration = Duration::from_millis(250);
+const MIN_TIMEOUT: Duration = Duration::from_millis(25);
+
+#[derive(Debug, Default)]
+pub(super) struct StatusLineCommandState {
+    pub(super) active_tools: Vec<(String, ToolPayload)>,
+    pub(super) agents: HashMap<String, AgentState>,
+    pub(super) output: Option<Vec<String>>,
+    pub(super) pending_request_id: Option<u64>,
+    pub(super) next_request_id: u64,
+    pub(super) last_requested_at: Option<Instant>,
+    pub(super) last_payload: Option<String>,
+}
+
+#[derive(Serialize)]
+struct StatusLineCommandPayload<'a> {
+    schema_version: u8,
+    session_id: Option<String>,
+    session_name: Option<&'a str>,
+    cwd: String,
+    project_dir: String,
+    model: ModelPayload<'a>,
+    version: &'static str,
+    context_window: ContextWindowPayload,
+    rate_limits: Vec<RateLimitPayload<'a>>,
+    effort: EffortPayload,
+    runtime: RuntimePayload,
+    activity: ActivityPayload,
+    pr: Option<PullRequestPayload>,
+    fast_mode: bool,
+    cost: CostPayload,
+    columns: u16,
+    rows: u16,
+}
+
+#[derive(Serialize)]
+struct ModelPayload<'a> {
+    id: &'a str,
+    display_name: &'a str,
+}
+
+#[derive(Serialize)]
+struct ContextWindowPayload {
+    used_tokens: Option<i64>,
+    used_percentage: Option<i64>,
+    remaining_percentage: Option<i64>,
+    context_window_size: Option<i64>,
+    total_input_tokens: i64,
+    total_output_tokens: i64,
+    cached_input_tokens: i64,
+    reasoning_output_tokens: i64,
+}
+
+#[derive(Serialize)]
+struct RateLimitPayload<'a> {
+    id: &'a str,
+    primary: Option<RateLimitWindowPayload<'a>>,
+    secondary: Option<RateLimitWindowPayload<'a>>,
+}
+
+#[derive(Serialize)]
+struct RateLimitWindowPayload<'a> {
+    used_percentage: f64,
+    resets_at: Option<&'a str>,
+    window_minutes: Option<i64>,
+}
+
+#[derive(Serialize)]
+struct EffortPayload {
+    level: String,
+}
+
+#[derive(Serialize)]
+struct RuntimePayload {
+    state: String,
+    task_progress: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub(super) struct ToolPayload {
+    name: String,
+    detail: String,
+}
+
+#[derive(Serialize)]
+struct ActivityPayload {
+    tool: Option<ToolPayload>,
+    todos: Option<TodoPayload>,
+    agents: usize,
+    agent_attention: Vec<AgentAttentionPayload>,
+}
+
+#[derive(Debug, Default)]
+pub(super) struct AgentState {
+    running: bool,
+    path: Option<String>,
+    attention: Option<AgentAttentionKind>,
+}
+
+impl AgentState {
+    fn stop(&mut self) {
+        self.running = false;
+        if self.attention != Some(AgentAttentionKind::Failed) {
+            self.attention = None;
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum AgentAttentionKind {
+    Failed,
+    WaitingApproval,
+    WaitingInput,
+}
+
+#[derive(Serialize)]
+struct AgentAttentionPayload {
+    name: String,
+    status: AgentAttentionKind,
+}
+
+#[derive(Serialize)]
+struct TodoPayload {
+    done: usize,
+    total: usize,
+}
+
+#[derive(Serialize)]
+struct PullRequestPayload {
+    number: u64,
+    url: String,
+}
+
+#[derive(Serialize)]
+struct CostPayload {
+    estimated_thread_cost_usd_micros: Option<i64>,
+    estimated_thread_credits_micros: Option<i64>,
+}
+
+fn status_line_file_name(path: &str) -> String {
+    Path::new(path)
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or(path)
+        .to_string()
+}
+
+fn packaged_status_line_command() -> Option<TuiStatusLineCommand> {
+    static COMMAND: OnceLock<Option<TuiStatusLineCommand>> = OnceLock::new();
+    COMMAND
+        .get_or_init(|| {
+            let context = codex_install_context::InstallContext::current();
+            let resources = context.package_layout.as_ref()?.resources_dir.as_ref()?;
+            let renderer = resources.as_path().join("agent-statusline/statusline.js");
+            if !renderer.is_file() {
+                return None;
+            }
+            let search_path = std::env::var_os("PATH")?;
+            let node_name = if cfg!(windows) { "node.exe" } else { "node" };
+            let node = std::env::split_paths(&search_path)
+                .filter(|dir| dir.is_absolute())
+                .map(|dir| dir.join(node_name))
+                .find(|file| file.is_file())?;
+            Some(TuiStatusLineCommand {
+                command: vec![
+                    node.display().to_string(),
+                    renderer.display().to_string(),
+                    "--codex-native".into(),
+                ],
+                refresh_interval_ms: 1_000,
+                timeout_ms: 1_500,
+                max_lines: MAX_RENDERED_LINES,
+            })
+        })
+        .clone()
+}
+
+impl ChatWidget {
+    pub(crate) fn set_status_line_agent_status(
+        &mut self,
+        id: &str,
+        status: &codex_app_server_protocol::ThreadStatus,
+    ) {
+        let Some(agent) = self.status_line_command.agents.get_mut(id) else {
+            return;
+        };
+        match status {
+            codex_app_server_protocol::ThreadStatus::Active { active_flags } => {
+                agent.running = true;
+                agent.attention = if active_flags
+                    .contains(&codex_app_server_protocol::ThreadActiveFlag::WaitingOnApproval)
+                {
+                    Some(AgentAttentionKind::WaitingApproval)
+                } else if active_flags
+                    .contains(&codex_app_server_protocol::ThreadActiveFlag::WaitingOnUserInput)
+                {
+                    Some(AgentAttentionKind::WaitingInput)
+                } else {
+                    None
+                };
+            }
+            codex_app_server_protocol::ThreadStatus::SystemError => {
+                agent.running = false;
+                agent.attention = Some(AgentAttentionKind::Failed);
+            }
+            codex_app_server_protocol::ThreadStatus::Idle
+            | codex_app_server_protocol::ThreadStatus::NotLoaded => agent.stop(),
+        }
+    }
+
+    pub(crate) fn set_status_line_agent_turn(
+        &mut self,
+        id: &str,
+        status: &codex_app_server_protocol::TurnStatus,
+    ) {
+        let Some(agent) = self.status_line_command.agents.get_mut(id) else {
+            return;
+        };
+        agent.running = matches!(status, codex_app_server_protocol::TurnStatus::InProgress);
+        agent.attention = matches!(status, codex_app_server_protocol::TurnStatus::Failed)
+            .then_some(AgentAttentionKind::Failed);
+    }
+
+    pub(crate) fn remove_status_line_agent(&mut self, id: &str) {
+        self.status_line_command.agents.remove(id);
+    }
+
+    fn status_line_agent_attention(&self) -> Vec<AgentAttentionPayload> {
+        let mut alerts: Vec<_> = self
+            .status_line_command
+            .agents
+            .iter()
+            .filter_map(|(id, agent)| {
+                let status = agent.attention?;
+                let metadata = ThreadId::from_string(id)
+                    .ok()
+                    .and_then(|thread| self.collab_agent_metadata.get(&thread));
+                let name = metadata
+                    .and_then(|meta| meta.agent_nickname.as_deref())
+                    .or(agent.path.as_deref())
+                    .or_else(|| metadata.and_then(|meta| meta.agent_role.as_deref()))
+                    .unwrap_or(id);
+                Some(AgentAttentionPayload {
+                    name: name
+                        .chars()
+                        .filter(|ch| !ch.is_control())
+                        .take(24)
+                        .collect(),
+                    status,
+                })
+            })
+            .collect();
+        alerts.sort_by(|a, b| a.status.cmp(&b.status).then_with(|| a.name.cmp(&b.name)));
+        alerts
+    }
+
+    pub(super) fn observe_status_line_item(&mut self, item: &ThreadItem, started: bool) {
+        if let codex_app_server_protocol::ThreadItemPayload::SubAgentActivity {
+            kind,
+            agent_thread_id,
+            agent_path,
+            ..
+        } = &item.payload
+        {
+            let agent = self
+                .status_line_command
+                .agents
+                .entry(agent_thread_id.clone())
+                .or_default();
+            agent.path = Some(agent_path.clone());
+            match kind {
+                codex_app_server_protocol::SubAgentActivityKind::Started => {
+                    agent.running = true;
+                    agent.attention = None;
+                }
+                codex_app_server_protocol::SubAgentActivityKind::Completed => agent.stop(),
+                codex_app_server_protocol::SubAgentActivityKind::Interrupted => {
+                    agent.running = false;
+                    agent.attention = None;
+                }
+                codex_app_server_protocol::SubAgentActivityKind::Interacted => {}
+            }
+        }
+        if let codex_app_server_protocol::ThreadItemPayload::CollabAgentToolCall { agents_states, .. } = &item.payload {
+            for (id, state) in agents_states {
+                let agent = self
+                    .status_line_command
+                    .agents
+                    .entry(id.clone())
+                    .or_default();
+                agent.running = matches!(
+                    state.status,
+                    codex_app_server_protocol::CollabAgentStatus::PendingInit
+                        | codex_app_server_protocol::CollabAgentStatus::Running
+                );
+                match state.status {
+                    codex_app_server_protocol::CollabAgentStatus::Errored => {
+                        agent.attention = Some(AgentAttentionKind::Failed)
+                    }
+                    codex_app_server_protocol::CollabAgentStatus::PendingInit
+                    | codex_app_server_protocol::CollabAgentStatus::Running => {
+                        if agent.attention == Some(AgentAttentionKind::Failed) {
+                            agent.attention = None;
+                        }
+                    }
+                    _ => agent.attention = None,
+                }
+            }
+        }
+        self.status_line_command
+            .active_tools
+            .retain(|(id, _)| id != item.id());
+        if !started {
+            return;
+        }
+        let (name, detail) = match &item.payload {
+            codex_app_server_protocol::ThreadItemPayload::CommandExecution { command, .. } => ("exec".to_string(), command.clone()),
+            codex_app_server_protocol::ThreadItemPayload::FileChange { changes, .. } => (
+                "apply_patch".to_string(),
+                changes
+                    .first()
+                    .map(|change| status_line_file_name(&change.path.to_string()))
+                    .unwrap_or_default(),
+            ),
+            codex_app_server_protocol::ThreadItemPayload::McpToolCall {
+                tool, arguments, ..
+            }
+            | codex_app_server_protocol::ThreadItemPayload::DynamicToolCall {
+                tool, arguments, ..
+            } => (
+                tool.clone(),
+                ["file_path", "path"]
+                    .iter()
+                    .find_map(|key| arguments.get(key).and_then(serde_json::Value::as_str))
+                    .map(status_line_file_name)
+                    .or_else(|| {
+                        ["command", "cmd", "description"]
+                            .iter()
+                            .find_map(|key| arguments.get(key).and_then(serde_json::Value::as_str))
+                            .map(str::to_string)
+                    })
+                    .unwrap_or_default(),
+            ),
+            _ => return,
+        };
+        self.status_line_command.active_tools.push((
+            item.id().to_string(),
+            ToolPayload {
+                name,
+                detail: detail.chars().take(40).collect(),
+            },
+        ));
+    }
+
+    pub(super) fn configured_status_line_command(&self) -> Option<TuiStatusLineCommand> {
+        match self.config.tui_status_line_command.as_ref() {
+            Some(config) => (!config.command.is_empty()).then(|| config.clone()),
+            None => packaged_status_line_command(),
+        }
+    }
+
+    fn status_line_command_payload(&mut self) -> String {
+        let usage = self.status_line_total_usage();
+        let context_remaining = self.status_line_context_remaining_percent();
+        let cwd = self
+            .current_cwd
+            .as_deref()
+            .unwrap_or(self.config.cwd.as_path())
+            .display()
+            .to_string();
+        let rate_limits = self
+            .rate_limit_snapshots_by_limit_id
+            .iter()
+            .map(|(id, snapshot)| RateLimitPayload {
+                id,
+                primary: snapshot
+                    .primary
+                    .as_ref()
+                    .map(|window| RateLimitWindowPayload {
+                        used_percentage: window.used_percent,
+                        resets_at: window.resets_at.as_deref(),
+                        window_minutes: window.window_minutes,
+                    }),
+                secondary: snapshot
+                    .secondary
+                    .as_ref()
+                    .map(|window| RateLimitWindowPayload {
+                        used_percentage: window.used_percent,
+                        resets_at: window.resets_at.as_deref(),
+                        window_minutes: window.window_minutes,
+                    }),
+            })
+            .collect();
+        let estimated_usage = self.estimated_thread_usage();
+        let payload = StatusLineCommandPayload {
+            schema_version: 1,
+            session_id: self.thread_id.map(|id| id.to_string()),
+            session_name: self.thread_name.as_deref(),
+            cwd,
+            project_dir: self.config.cwd.display().to_string(),
+            model: ModelPayload {
+                id: self.current_model(),
+                display_name: self.model_display_name(),
+            },
+            version: CODEX_CLI_VERSION,
+            context_window: ContextWindowPayload {
+                used_tokens: (!self.token_usage_pending)
+                    .then(|| {
+                        self.token_info
+                            .as_ref()
+                            .map(|info| info.last_token_usage.total_tokens)
+                    })
+                    .flatten(),
+                used_percentage: context_remaining.map(|remaining| 100 - remaining),
+                remaining_percentage: context_remaining,
+                context_window_size: self.status_line_context_window_size(),
+                total_input_tokens: usage.input_tokens,
+                total_output_tokens: usage.output_tokens,
+                cached_input_tokens: usage.cached_input_tokens,
+                reasoning_output_tokens: usage.reasoning_output_tokens,
+            },
+            rate_limits,
+            effort: EffortPayload {
+                level: Self::status_line_reasoning_effort_label(
+                    self.effective_reasoning_effort().as_ref(),
+                ),
+            },
+            runtime: RuntimePayload {
+                state: self.run_state_status_text(),
+                task_progress: self.terminal_title_task_progress(),
+            },
+            activity: ActivityPayload {
+                tool: self
+                    .status_line_command
+                    .active_tools
+                    .last()
+                    .map(|(_, tool)| tool.clone()),
+                todos: self
+                    .transcript
+                    .last_plan_progress
+                    .map(|(done, total)| TodoPayload { done, total }),
+                agents: self
+                    .status_line_command
+                    .agents
+                    .values()
+                    .filter(|agent| agent.running)
+                    .count(),
+                agent_attention: self.status_line_agent_attention(),
+            },
+            pr: self
+                .status_line_git_summary
+                .as_ref()
+                .and_then(|summary| summary.pull_request.as_ref())
+                .map(|pr| PullRequestPayload {
+                    number: pr.number,
+                    url: pr.url.clone(),
+                }),
+            fast_mode: self.effective_service_tier.as_deref() == Some("fast"),
+            cost: CostPayload {
+                estimated_thread_cost_usd_micros: estimated_usage
+                    .and_then(|usage| usage.estimated_usage_usd_micros),
+                estimated_thread_credits_micros: estimated_usage
+                    .map(|usage| usage.estimated_usage_credits_micros),
+            },
+            columns: self.last_rendered_width.get().unwrap_or(80),
+            rows: crossterm::terminal::size()
+                .map(|(_, rows)| rows)
+                .unwrap_or(24),
+        };
+        serde_json::to_string(&payload).unwrap_or_else(|_| "{}".to_string())
+    }
+
+    fn request_status_line_command_if_due(&mut self, now: Instant) {
+        if self.status_line_command.pending_request_id.is_some() {
+            return;
+        }
+        let Some(config) = self.configured_status_line_command() else {
+            self.status_line_command = StatusLineCommandState::default();
+            return;
+        };
+        let payload = self.status_line_command_payload();
+        let refresh_interval =
+            Duration::from_millis(config.refresh_interval_ms).max(MIN_REFRESH_INTERVAL);
+        let interval_elapsed = self
+            .status_line_command
+            .last_requested_at
+            .is_none_or(|last| now.saturating_duration_since(last) >= refresh_interval);
+        if !interval_elapsed {
+            if let Some(last) = self.status_line_command.last_requested_at {
+                self.frame_requester.schedule_frame_in(
+                    refresh_interval.saturating_sub(now.saturating_duration_since(last)),
+                );
+            }
+            return;
+        }
+
+        let request_id = self.status_line_command.next_request_id;
+        self.status_line_command.next_request_id = request_id.wrapping_add(/*rhs*/ 1);
+        self.status_line_command.pending_request_id = Some(request_id);
+        self.status_line_command.last_requested_at = Some(now);
+        self.status_line_command.last_payload = Some(payload.clone());
+        let cwd = self
+            .current_cwd
+            .clone()
+            .unwrap_or_else(|| self.config.cwd.to_path_buf());
+        self.app_event_tx.send(AppEvent::RefreshStatusLineCommand {
+            request_id,
+            config,
+            payload,
+            cwd,
+        });
+    }
+
+    pub(crate) fn refresh_status_line_command_if_due(&mut self) {
+        self.request_status_line_command_if_due(Instant::now());
+    }
+
+    pub(crate) fn set_status_line_command_output(
+        &mut self,
+        request_id: u64,
+        result: Result<Option<Vec<String>>, String>,
+    ) -> bool {
+        if self.status_line_command.pending_request_id != Some(request_id) {
+            return false;
+        }
+        self.status_line_command.pending_request_id = None;
+        match result {
+            Ok(output) => self.status_line_command.output = output,
+            Err(error) => {
+                tracing::debug!(%error, "status-line command failed; keeping last output")
+            }
+        }
+        self.refresh_status_surfaces();
+        true
+    }
+}
+
+pub(crate) async fn run_status_line_command(
+    config: &TuiStatusLineCommand,
+    payload: &str,
+    cwd: &Path,
+) -> Result<Option<Vec<String>>, String> {
+    let Some((program, args)) = config.command.split_first() else {
+        return Ok(None);
+    };
+    let mut command = tokio::process::Command::new(program);
+    command
+        .args(args)
+        .current_dir(cwd)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true);
+    let mut child = command
+        .spawn()
+        .map_err(|error| format!("failed to start status-line command: {error}"))?;
+    let mut stdin = child.stdin.take();
+    let mut stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| "status-line command did not provide stdout".to_string())?;
+    let payload = payload.as_bytes().to_vec();
+    let run = async move {
+        let writer = async move {
+            if let Some(mut stdin) = stdin.take() {
+                stdin.write_all(&payload).await?;
+                stdin.shutdown().await?;
+            }
+            std::io::Result::Ok(())
+        };
+        let reader = async move {
+            let mut retained = Vec::new();
+            let mut chunk = [0u8; 4096];
+            loop {
+                let read = stdout.read(&mut chunk).await?;
+                if read == 0 {
+                    break;
+                }
+                let remaining = MAX_CAPTURE_BYTES.saturating_sub(retained.len());
+                retained.extend_from_slice(&chunk[..read.min(remaining)]);
+            }
+            std::io::Result::Ok(retained)
+        };
+        let (write_result, read_result, wait_result) = tokio::join!(writer, reader, child.wait());
+        write_result.map_err(|error| error.to_string())?;
+        let output = read_result.map_err(|error| error.to_string())?;
+        let status = wait_result.map_err(|error| error.to_string())?;
+        if !status.success() {
+            return Err(format!("status-line command exited with {status}"));
+        }
+        Ok(output)
+    };
+    let timeout = Duration::from_millis(config.timeout_ms).max(MIN_TIMEOUT);
+    let output = tokio::time::timeout(timeout, run)
+        .await
+        .map_err(|_| "status-line command timed out".to_string())??;
+    let output = String::from_utf8_lossy(&output);
+    let max_lines = config.max_lines.clamp(1, MAX_RENDERED_LINES);
+    let lines = output
+        .lines()
+        .map(sanitize_status_line)
+        .filter(|line| !line.trim().is_empty())
+        .take(max_lines)
+        .collect::<Vec<_>>();
+    Ok((!lines.is_empty()).then_some(lines))
+}
+
+fn sanitize_status_line(input: &str) -> String {
+    let mut output = String::new();
+    let mut chars = input.chars().peekable();
+    while let Some(ch) = chars.next() {
+        if ch == '\u{1b}' {
+            if chars.next_if_eq(&']').is_some() {
+                while let Some(next) = chars.next() {
+                    if next == '\u{7}' || (next == '\u{1b}' && chars.next_if_eq(&'\\').is_some()) {
+                        break;
+                    }
+                }
+                continue;
+            }
+            if chars.next_if_eq(&'[').is_some() {
+                let mut params = String::new();
+                while let Some(next) = chars.peek().copied() {
+                    chars.next();
+                    if next == 'm' {
+                        output.push('\u{1b}');
+                        output.push('[');
+                        output.push_str(&params);
+                        output.push('m');
+                        break;
+                    }
+                    if next.is_ascii_digit() || next == ';' {
+                        params.push(next);
+                    } else {
+                        while let Some(rest) = chars.peek().copied() {
+                            chars.next();
+                            if rest.is_ascii_alphabetic() {
+                                break;
+                            }
+                        }
+                        break;
+                    }
+                }
+            }
+            continue;
+        }
+        if ch.is_control()
+            || matches!(
+                ch,
+                '\u{202a}'
+                    | '\u{202b}'
+                    | '\u{202c}'
+                    | '\u{202d}'
+                    | '\u{202e}'
+                    | '\u{2066}'
+                    | '\u{2067}'
+                    | '\u{2068}'
+                    | '\u{2069}'
+            )
+        {
+            continue;
+        }
+        output.push(ch);
+    }
+    output
+}
