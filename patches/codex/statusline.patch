+#[tokio::test]
+async fn agent_attention_tracks_waiting_failure_retry_and_close() {
+    use codex_app_server_protocol::ThreadActiveFlag;
+    use codex_app_server_protocol::ThreadStatus;
+    use codex_app_server_protocol::TurnStatus;
+    let (mut chat, _sender, _events, _operations) =
+        crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+    let thread = ThreadId::from_u128(900);
+    let id = thread.to_string();
+    let mut item: ThreadItem = serde_json::from_value(serde_json::json!({
+        "type": "subAgentActivity", "id": "agent", "kind": "started",
+        "agentThreadId": id, "agentPath": "workers/reviewer", "model": null, "reasoningEffort": null
+    }))
+    .unwrap();
+    chat.observe_status_line_item(&item, false);
+    chat.set_collab_agent_metadata(thread, Some("reviewer".into()), Some("worker".into()));
+    for (flag, expected) in [
+        (ThreadActiveFlag::WaitingOnApproval, "waiting_approval"),
+        (ThreadActiveFlag::WaitingOnUserInput, "waiting_input"),
+    ] {
+        chat.set_status_line_agent_status(
+            &id,
+            &ThreadStatus::Active {
+                active_flags: vec![flag],
+            },
+        );
+        let payload: serde_json::Value =
+            serde_json::from_str(&chat.status_line_command_payload()).unwrap();
+        assert_eq!(payload["activity"]["agents"], 1);
+        assert_eq!(
+            payload["activity"]["agent_attention"],
+            serde_json::json!([{"name": "reviewer", "status": expected}])
+        );
+    }
+    chat.set_status_line_agent_status(
+        &id,
+        &ThreadStatus::Active {
+            active_flags: vec![],
+        },
+    );
+    assert!(chat.status_line_agent_attention().is_empty());
+    chat.set_status_line_agent_turn(&id, &TurnStatus::Failed);
+    chat.set_status_line_agent_status(&id, &ThreadStatus::Idle);
+    if let codex_app_server_protocol::ThreadItemPayload::SubAgentActivity { kind, .. } =
+        &mut item.payload
+    {
+        *kind = codex_app_server_protocol::SubAgentActivityKind::Completed;
+    }
+    chat.observe_status_line_item(&item, false);
+    assert_eq!(
+        chat.status_line_agent_attention()[0].status,
+        AgentAttentionKind::Failed
+    );
+    chat.set_status_line_agent_turn(&id, &TurnStatus::Completed);
+    assert!(chat.status_line_agent_attention().is_empty());
+    chat.set_status_line_agent_status(&id, &ThreadStatus::SystemError);
+    chat.set_status_line_agent_status(
+        &id,
+        &ThreadStatus::Active {
+            active_flags: vec![],
+        },
+    );
+    assert!(chat.status_line_agent_attention().is_empty());
+    chat.set_status_line_agent_status(&id, &ThreadStatus::SystemError);
+    chat.remove_status_line_agent(&id);
+    chat.set_status_line_agent_status("unrelated", &ThreadStatus::SystemError);
+    assert!(chat.status_line_agent_attention().is_empty());
+    assert!(chat.status_line_command.agents.is_empty());
+}
