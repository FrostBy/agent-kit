+            Span::styled(
+                "👩‍💻",
+                Style::default()
+                    .fg(Color::Cyan)
+                    .add_modifier(Modifier::UNDERLINED),
+            ),
+            Span::styled("e\u{301}", Style::default().fg(Color::Magenta)),
+            Span::styled("状态", Style::default().fg(Color::Green)),
+        ]),
+        Line::from("done"),
+    ]));
+
+    let width = 12;
+    let height = chat.desired_height(width);
+    let mut terminal =
+        ratatui::Terminal::new(TestBackend::new(width, height)).expect("create terminal");
+    terminal
+        .draw(|frame| chat.render(frame.area(), frame.buffer_mut()))
+        .expect("render unicode footer rows");
+    let rendered = normalized_backend_snapshot(terminal.backend());
+    assert!(rendered.contains("模型👩‍💻e\u{301}状"));
+    assert!(rendered.contains("态 · done"));
+
+    let area = terminal.backend().buffer().area;
+    let find_cell = |grapheme: &str| {
+        (area.top()..area.bottom())
+            .flat_map(|y| (area.left()..area.right()).map(move |x| (x, y)))
+            .find(|&(x, y)| terminal.backend().buffer()[(x, y)].symbol() == grapheme)
+            .expect("styled status grapheme")
+    };
+    let chinese = find_cell("模");
+    let emoji = find_cell("👩‍💻");
+    let combining = find_cell("e\u{301}");
+    let final_chinese = find_cell("态");
+    assert_eq!(chinese.1, emoji.1);
+    assert_eq!(emoji.1, combining.1);
+    assert!(chinese.0 < emoji.0);
+    assert!(emoji.0 < combining.0);
+    assert!(final_chinese.1 > combining.1);
+    assert_eq!(
+        terminal.backend().buffer()[chinese].style().fg,
+        Some(Color::Red)
+    );
+    assert_eq!(
+        terminal.backend().buffer()[emoji].style().fg,
+        Some(Color::Cyan)
+    );
+    assert!(
+        terminal.backend().buffer()[emoji]
+            .style()
+            .add_modifier
+            .contains(Modifier::UNDERLINED)
+    );
+    assert_eq!(
+        terminal.backend().buffer()[combining].style().fg,
+        Some(Color::Magenta)
+    );
+    assert_chatwidget_snapshot!(
+        "status_line_unicode_graphemes_and_styles_survive_widget_reflow",
+        rendered
+    );
+}
