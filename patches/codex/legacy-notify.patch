+#[cfg(any(windows, test))]
+fn windows_arg_bound(arg: &str) -> usize {
+    // Reserve quoting, the argument separator, and worst-case escaping.
+    arg.encode_utf16().count() + arg.bytes().filter(|&byte| matches!(byte, b'\\' | b'"')).count() + 3
+}
+
+#[cfg(any(windows, test))]
+fn notification_preview(text: &str, limit: usize) -> String {
+    match text.char_indices().nth(limit) {
+        Some((end, _)) => format!("{}\u{2026}", &text[..end]),
+        None => text.to_owned(),
+    }
+}
+
+#[cfg(any(windows, test))]
+fn windows_notify_json(
+    payload: &HookPayload,
+    argv: &[String],
+) -> Result<Option<String>, serde_json::Error> {
+    // Leave headroom below the CreateProcessW limit, including the executable path.
+    let available = 30_000usize.saturating_sub(argv.iter().map(|arg| windows_arg_bound(arg)).sum());
+    let full = legacy_notify_json(payload)?;
+    if windows_arg_bound(&full) <= available {
+        return Ok(Some(full));
+    }
+
+    let mut preview = payload.clone();
+    let HookEvent::AfterAgent { event } = &mut preview.hook_event;
+    let input = event.input_messages.pop();
+    let answer = event.last_assistant_message.take();
+    for limit in [8_192, 2_048, 512, 128, 0] {
+        let HookEvent::AfterAgent { event } = &mut preview.hook_event;
+        event.input_messages = input
+            .as_deref()
+            .map(|text| notification_preview(text, limit))
+            .into_iter()
+            .collect();
+        event.last_assistant_message = answer
+            .as_deref()
+            .map(|text| notification_preview(text, limit));
+        let json = legacy_notify_json(&preview)?;
+        if windows_arg_bound(&json) <= available {
+            return Ok(Some(json));
+        }
+    }
+    Ok(None)
+}
