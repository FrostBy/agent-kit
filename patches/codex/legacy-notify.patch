+    #[test]
+    fn windows_notify_keeps_short_payloads_and_bounds_escaped_previews() -> Result<()> {
+        let mut payload = HookPayload {
+            session_id: ThreadId::new(),
+            cwd: test_path_buf("/Users/example/project").abs(),
+            client: Some("codex-tui".to_string()),
+            triggered_at: chrono::Utc::now(),
+            hook_event: HookEvent::AfterAgent {
+                event: HookEventAfterAgent {
+                    thread_id: ThreadId::new(),
+                    turn_id: "12345".to_string(),
+                    input_messages: vec!["Short input".to_string()],
+                    last_assistant_message: Some("Short answer".to_string()),
+                },
+            },
+        };
+        let argv = vec!["C:\\Program Files\\Example\\notify.exe".to_string()];
+        let short = legacy_notify_json(&payload)?;
+        assert_eq!(windows_notify_json(&payload, &argv)?, Some(short.clone()));
+
+        let HookEvent::AfterAgent { event } = &mut payload.hook_event;
+        let text = format!("\u{411}\u{414} \u{1f600} {}", "\"\\\n\u{0001}".repeat(8_000));
+        event.input_messages = vec!["Earlier input".repeat(4_000), text.clone()];
+        event.last_assistant_message = Some(text);
+        let bounded = windows_notify_json(&payload, &argv)?.expect("notification fits");
+        assert!(windows_arg_bound(&bounded) + windows_arg_bound(&argv[0]) <= 30_000);
+        let actual: Value = serde_json::from_str(&bounded)?;
+        let short: Value = serde_json::from_str(&short)?;
+        for key in ["type", "thread-id", "turn-id", "cwd", "client"] {
+            assert_eq!(actual[key], short[key]);
+        }
+        assert_eq!(actual["input-messages"].as_array().expect("inputs").len(), 1);
+        for value in [&actual["input-messages"][0], &actual["last-assistant-message"]] {
+            let text = value.as_str().expect("preview");
+            assert!(text.starts_with("\u{411}\u{414} \u{1f600}"));
+            assert!(text.ends_with('\u{2026}'));
+        }
+        assert!(windows_notify_json(&payload, &["a".repeat(30_000)])?.is_none());
