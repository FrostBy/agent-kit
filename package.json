{
  "name": "agent-kit",
  "version": "0.4.0",
  "description": "A dependency-free kit for Claude Code statuslines, custom Codex native features and faster Codex voice.",
  "bin": { "agent-kit": "statusline.js", "agent-statusline": "statusline.js", "claude-statusline-ultimate": "statusline.js" },
  "main": "statusline.js",
  "files": ["statusline.js", "src/", "install.js", "install.sh", "install.cmd", "scripts/codex/", "patches/", "templates/", "README.md", "README.RU.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "codex:prepare": "node scripts/codex/cli.js prepare",
    "codex:build": "node scripts/codex/cli.js build",
    "codex:install": "node scripts/codex/cli.js install",
    "codex:restore": "node scripts/codex/cli.js restore",
    "codex:sync-footer": "node scripts/codex/cli.js sync-footer"
  },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/FrostBy/agent-kit.git" },
  "homepage": "https://github.com/FrostBy/agent-kit#readme",
  "bugs": { "url": "https://github.com/FrostBy/agent-kit/issues" },
  "keywords": ["codex", "openai", "claude", "claude-code", "statusline", "status-line", "anthropic", "cli", "terminal", "git", "monorepo", "rate-limit", "tui"],
  "author": "Vladislav Romanovsky <frost.by@gmail.com>",
  "license": "MIT"
}
